# ═══════════════════════════════════════════════════════════════════════════════
#  Golden Vape — backend Medusa : variables d'environnement
#
#  Copier en `.env` pour le local ; poser les mêmes noms dans Railway (service backend)
#  pour la prod. Convention des étiquettes ci-dessous :
#    [requis]   sans elle, l'application ne démarre pas ou la fonction échoue
#    [prod]     à renseigner sur Railway ; peut rester vide ou factice en local
#    [option]   un défaut raisonnable s'applique si elle est vide
#  Tout ce qui écrit chez un tiers (caisse, emails, paiement réel) est éteint ou en bac à
#  sable par défaut : il faut l'allumer explicitement, variable par variable.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────────
# [requis] PostgreSQL. Local : postgres://davidplanchon@localhost:5432/golden_vape.
# Prod : l'URL Neon, avec ?sslmode=require. Un script `medusa exec` vise la base de `.env`
# quoi qu'il arrive : pour en viser une autre, passer DATABASE_URL dans le shell et lire la
# ligne « Base : … » que les scripts affichent en tête.
DATABASE_URL=

# ── Secrets ─────────────────────────────────────────────────────────────────────
# [requis] Signature des sessions et cookies de l'admin. Générer : openssl rand -hex 32.
# Jamais « supersecret » en prod.
JWT_SECRET=
COOKIE_SECRET=

# ── CORS ────────────────────────────────────────────────────────────────────────
# [requis] Origines autorisées à appeler l'API, séparées par des virgules.
# Local : http://localhost:3000 (site) et http://localhost:9000 (admin, servi par le backend).
STORE_CORS=https://golden-vape.fr
ADMIN_CORS=https://admin.golden-vape.fr
AUTH_CORS=https://admin.golden-vape.fr

# ── URL publique du backend ─────────────────────────────────────────────────────
# [prod] Base des liens d'étiquette Sendcloud affichés dans l'admin : sans elle, le lien
# rendu à Medusa ne s'ouvre pas depuis un navigateur. Local : http://localhost:9000.
MEDUSA_BACKEND_URL=https://api.golden-vape.fr

# ── Redis ───────────────────────────────────────────────────────────────────────
# [prod] Sessions admin et cache partagé (recherche, dernier rapport de stock). Railway le
# fournit par référence : ${{Redis.REDIS_URL}}. Vide en local : Medusa retombe sur un cache
# en mémoire, sans autre différence.
REDIS_URL=

# ── Cloudflare R2 — images produits ─────────────────────────────────────────────
# [requis] Bucket S3-compatible où l'admin téléverse les visuels. Les quatre premières
# viennent du tableau de bord Cloudflare (R2 → jetons API) ; la dernière est l'URL publique
# du bucket, celle que le site met dans ses <img>.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=golden-vape-media
R2_PUBLIC_URL=

# ── Hiboutik — la caisse ────────────────────────────────────────────────────────
# [requis] Accès à l'API : Paramètres → API dans Hiboutik. `account` est le sous-domaine
# (goldenvape pour goldenvape.hiboutik.com).
HIBOUTIK_ACCOUNT=
HIBOUTIK_USER=
HIBOUTIK_API_KEY=
# [option] Jeton qu'un futur webhook Hiboutik devra présenter. Inutilisé aujourd'hui.
HIBOUTIK_WEBHOOK_SECRET=
# [option] Entrepôt dont le stock fait foi. Le compte en a deux : 1 « Stock Golden Vape »,
# 2 « Stock VapoBeer » — une autre boutique, à ne jamais synchroniser.
HIBOUTIK_WAREHOUSE_ID=1
# [prod] Stock caisse → site : une tâche lit tout l'entrepôt en un appel et n'écrit que ce
# qui change. Éteinte par défaut ; à allumer sur Railway. Le cron se lit sur crontab.guru.
HIBOUTIK_STOCK_SYNC_ENABLED=false
HIBOUTIK_STOCK_SYNC_CRON=*/10 * * * *
# [prod] Commande web → vente en caisse, dès que le paiement est accepté (le marchand veut une
# vente, pas un déstockage, pour que ses synthèses restent justes). Éteinte par défaut.
# En simulation, la vente qui serait créée est seulement journalisée : c'est le réglage à
# garder en local. Sur Railway : ENABLED=true et SIMULATION=false.
HIBOUTIK_SALES_PUSH_ENABLED=false
HIBOUTIK_SALES_PUSH_SIMULATION=true
# [option] Point de vente (1 = « Golden vape Lure ») et type de paiement portés par ces ventes
# (CB : Monetico encaisse par carte ; un type « WEB » créé en caisse les distinguerait).
HIBOUTIK_STORE_ID=1
HIBOUTIK_PAYMENT_TYPE=CB
# [option] Client Hiboutik générique « site web » et vendeur à rattacher aux ventes web, si le
# marchand en crée. Vides : aucun.
HIBOUTIK_CUSTOMER_ID=
HIBOUTIK_VENDOR_ID=
# [option] Délai maximal d'un appel à l'API, en millisecondes.
HIBOUTIK_TIMEOUT_MS=20000

# ── Monetico Paiement — back-office « Mes TPE » ─────────────────────────────────
# [requis] Numéro de TPE et code société, fournis par Monetico à la création du contrat.
MONETICO_TPE=
MONETICO_SOCIETE=
# [requis] Clé de sécurité du TPE : 40 caractères hexadécimaux. Elle signe chaque échange ;
# une clé fausse fait refuser tous les paiements.
MONETICO_KEY=
# [prod] true = serveur de test Monetico (aucun débit réel). false sur Railway, une fois le
# TPE ouvert en production.
MONETICO_SANDBOX=true
# [requis] Pages du site où Monetico renvoie le client après paiement réussi ou refusé. Ce
# sont des route handlers Next qui acceptent GET comme POST : Monetico utilise les deux.
MONETICO_URL_RETOUR_OK=
MONETICO_URL_RETOUR_ERR=
# [option] Langue de la page de paiement.
MONETICO_LGUE=FR
# [option] true si l'option « iframe » est souscrite au contrat.
MONETICO_IFRAME=false
# [option] Fuseau des horodatages envoyés à Monetico.
MONETICO_TIMEZONE=Europe/Paris
# [option] true si le TPE est paramétré en paiement différé ou partiel : l'encaissement se
# fait alors à l'expédition, pas à la commande.
MONETICO_DEFERRED_CAPTURE=false
# Rappel : l'URL de notification serveur à serveur ne se configure PAS ici. Elle se règle
# dans le back-office Monetico, onglet TPE, champ « Uri de l'interface retour vers le
# marchand », et doit pointer sur https://<ce-backend>/hooks/payment/monetico_monetico.

# ── Sendcloud — transporteurs (Réglages → Intégrations → intégration « API ») ───
# Agrégateur : Colissimo, Chronopost et points relais par une seule API. Chaque intégration
# Sendcloud a son jeu de clés ET sa propre URL de webhook : en prévoir une par environnement
# plutôt que de basculer un réglage partagé.
# [requis] Clés de l'intégration.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# [option] Seulement si le panel affiche une clé de signature distincte pour les webhooks.
# Vide, on retombe sur SENDCLOUD_SECRET_KEY.
SENDCLOUD_WEBHOOK_SECRET=
# [option] true si l'intégration exige OAuth2 : l'authentification Basic y échoue alors.
SENDCLOUD_USE_OAUTH=false
# [option] Pays de départ des colis ; sert aussi de référence pour énumérer les services.
SENDCLOUD_COUNTRY_CODE=FR
# [prod] Adresse d'expéditeur. Vide, le provider prend la seule adresse du compte ; à
# renseigner dès qu'il y en a plusieurs — l'API v3 n'applique pas l'adresse « par défaut »
# du panel. Compte Golden Vape : 918586. Les identifiants se lisent avec :
#   curl -u "$SENDCLOUD_PUBLIC_KEY:$SENDCLOUD_SECRET_KEY" https://panel.sendcloud.sc/api/v3/addresses/sender-addresses
SENDCLOUD_SENDER_ADDRESS_ID=
# [option] Poids de repli en grammes quand aucune variante du colis n'a de poids. Vide,
# l'affranchissement échoue plutôt que de déclarer une valeur au hasard : un colis
# sous-évalué est repesé, puis refacturé. Ne joue que si TOUT le colis est sans poids.
SENDCLOUD_FALLBACK_WEIGHT_GRAMS=
# L'URL du webhook se déclare côté Sendcloud, pas ici : https://<ce-backend>/hooks/delivery/sendcloud

# ── Emails transactionnels — Resend ─────────────────────────────────────────────
# [prod] Clé API Resend. Vide, rien ne part : les emails sont rendus dans .medusa/emails/
# pour relecture — le réglage du local.
RESEND_API_KEY=
# [prod] Expéditeur affiché. Le domaine doit être vérifié chez Resend (SPF, DKIM).
EMAIL_FROM=Golden Vape <commandes@golden-vape.fr>
# [option] Adresse qui reçoit les réponses des clients, si différente de l'expéditeur.
EMAIL_REPLY_TO=
# [option] Base des liens dans les emails (suivi de commande, mot de passe). Vide, on prend
# la première origine https de STORE_CORS — ce qui suffit sur un environnement déployé, où
# elle n'en contient qu'une.
STOREFRONT_URL=

# ── Franchise de port ───────────────────────────────────────────────────────────
# [option] Montant HT du panier à partir duquel la livraison est offerte. Exprimé HT car
# c'est l'unité des prix de ligne que Medusa transmet au provider : à 20 % de TVA, 50 € HT
# correspondent à 60 € TTC annoncés au client. Vide, aucune franchise. La règle vit dans le
# provider et non dans une promotion Medusa, dont les règles n'acceptent aucun montant de
# panier.
SHIPPING_FREE_FROM_SUBTOTAL=
