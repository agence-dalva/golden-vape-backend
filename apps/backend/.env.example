# ── Base de données ────────────────────────────────────────────────────────────
# En prod : URL Neon (postgres://user:password@host/dbname?sslmode=require)
DATABASE_URL=

# ── Secrets (générer avec : openssl rand -hex 32) ─────────────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ── CORS (URLs de ton frontend et admin en prod) ───────────────────────────────
STORE_CORS=https://golden-vape.fr
ADMIN_CORS=https://admin.golden-vape.fr
AUTH_CORS=https://admin.golden-vape.fr

# ── URL publique du backend ────────────────────────────────────────────────────
# Sert de base aux liens d'étiquette Sendcloud affichés dans l'admin : sans elle, le
# lien rendu à Medusa ne s'ouvre pas depuis un navigateur.
MEDUSA_BACKEND_URL=https://api.golden-vape.fr

# ── Redis (Railway fournit REDIS_URL automatiquement) ─────────────────────────
REDIS_URL=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=golden-vape-media
R2_PUBLIC_URL=

# ── Hiboutik (Settings → API dans Hiboutik) ───────────────────────────────────
HIBOUTIK_ACCOUNT=
HIBOUTIK_USER=
HIBOUTIK_API_KEY=
HIBOUTIK_WEBHOOK_SECRET=

# ── Monetico Paiement (back-office « Mes TPE ») ───────────────────────────────
# Fournis par Monetico à la création du contrat.
MONETICO_TPE=
MONETICO_SOCIETE=
# Clé de sécurité du TPE : 40 caractères hexadécimaux.
MONETICO_KEY=
# false pour taper le serveur de production.
MONETICO_SANDBOX=true
# Route handlers Next qui acceptent GET comme POST : Monetico renvoie le navigateur
# dans les deux modes selon les cas.
MONETICO_URL_RETOUR_OK=
MONETICO_URL_RETOUR_ERR=
MONETICO_LGUE=FR
# true si l'option « iframe » est souscrite.
MONETICO_IFRAME=false
MONETICO_TIMEZONE=Europe/Paris
# true si le TPE est paramétré en paiement différé ou partiel.
MONETICO_DEFERRED_CAPTURE=false
# Rappel : l'URL de notification serveur à serveur ne se configure PAS ici. Elle se règle
# dans le back-office Monetico, onglet TPE, champ « Uri de l'interface retour vers le
# marchand », et doit pointer sur /hooks/payment/monetico_monetico de ce backend.

# ── Sendcloud (Réglages → Intégrations → intégration « API ») ─────────────────
# Agrégateur : Colissimo, Chronopost et points relais par une seule API.
# Chaque intégration a son jeu de clés ET sa propre URL de webhook — en prévoir une par
# environnement plutôt que de basculer un réglage partagé.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Seulement si le panel affiche une clé de signature distincte. Vide, on retombe sur
# SENDCLOUD_SECRET_KEY.
SENDCLOUD_WEBHOOK_SECRET=
# true si l'intégration exige OAuth2 : l'authentification Basic y échoue alors.
SENDCLOUD_USE_OAUTH=false
# Pays de départ, qui sert aussi de référence pour énumérer les services disponibles.
SENDCLOUD_COUNTRY_CODE=FR
# Vide, le provider prend la seule adresse d'expédition du compte. À renseigner dès qu'il
# y en a plusieurs : l'API v3 n'applique pas l'adresse « par défaut » du panel. Les
# identifiants se lisent avec :
#   curl -u "$SENDCLOUD_PUBLIC_KEY:$SENDCLOUD_SECRET_KEY" https://panel.sendcloud.sc/api/v3/addresses/sender-addresses
SENDCLOUD_SENDER_ADDRESS_ID=
# Poids de repli en grammes. Laissé vide, l'affranchissement échoue plutôt que de
# déclarer une valeur au hasard : un colis sous-évalué est repesé, puis refacturé.
SENDCLOUD_FALLBACK_WEIGHT_GRAMS=
# L'URL du webhook se déclare côté Sendcloud, pas ici :
#   https://<ce-backend>/hooks/delivery/sendcloud

# ── Franchise de port ─────────────────────────────────────────────────────────
# Montant HT du panier à partir duquel la livraison est offerte. Exprimé HT car c'est
# l'unité des prix de ligne que Medusa transmet au provider. À 20 % de TVA, 50 € HT
# correspondent à 60 € TTC annoncés au client. Vide, aucune franchise.
# La règle vit dans le provider et non dans une promotion Medusa : ses règles n'acceptent
# aucun attribut de montant de panier.
SHIPPING_FREE_FROM_SUBTOTAL=
